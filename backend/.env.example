# Server
PORT=4000
NODE_ENV=development

# Supabase (Postgres) — transactional data (users, bookings, payments)
#
# These three reach PostgREST (the REST API). The backend uses the service role
# key, which bypasses RLS — it must never be exposed to the frontend or given a
# NEXT_PUBLIC_ name. See backend/src/config/supabase.ts.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Direct Postgres connection — required for migrations and the live schema test.
# NOT interchangeable with SUPABASE_URL above: PostgREST cannot run DDL, hold a
# transaction open, or read pg_catalog.
#
# Dashboard → Project Settings → Database → Connection string → "Session pooler".
# Prefer the session pooler over the direct connection: direct connections are
# IPv6-only on newer projects unless you have the IPv4 add-on. Session mode
# (port 5432) supports DDL and transactions; transaction mode (6543) does not.
#
# Percent-encode the password if it contains special characters (@ : / ? # etc).
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# MongoDB — catalog content (movies, events, venues)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/encore

# Firebase Auth — token verification
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Redis — seat locking
REDIS_URL=redis://localhost:6379

# Stripe — payments
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Frontend origin (CORS)
FRONTEND_URL=http://localhost:3000
